{{!-- The figure the email is about: {{> amount label="Amount" value="UGX 10,000" chip="Completed" note="…"}} --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 20px 0;background-color:#EEF7EC;border-radius:12px;border-left:4px solid #70AF3E;">
  <tr>
    <td style="padding:16px 20px;font-family:Arial,Helvetica,sans-serif;">
      <div style="font-size:12px;line-height:1.4;color:#5B6B5D;">{{label}}</div>
      <div style="font-size:26px;line-height:1.3;font-weight:bold;color:#012203;">{{value}}</div>
      {{#if note}}<div style="font-size:12px;line-height:1.5;color:#5B6B5D;margin-top:4px;">{{note}}</div>{{/if}}
    </td>
    {{#if chip}}
    <td align="right" valign="top" style="padding:16px 20px 0 0;font-family:Arial,Helvetica,sans-serif;">
      <span style="display:inline-block;padding:4px 12px;border-radius:999px;background-color:#FFFFFF;font-size:12px;font-weight:bold;color:{{#if chipColor}}{{chipColor}}{{else}}#1F6B29{{/if}};">{{chip}}</span>
    </td>
    {{/if}}
  </tr>
</table>
