{{!-- Label / value rows from a `details` array: [{ label, value }] --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0;border:1px solid #E6EEE4;border-radius:12px;">
  {{#each details}}
  <tr>
    <td style="padding:10px 16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#5B6B5D;{{#unless @last}}border-bottom:1px solid #E6EEE4;{{/unless}}">{{label}}</td>
    <td align="right" style="padding:10px 16px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;color:#0E2112;{{#unless @last}}border-bottom:1px solid #E6EEE4;{{/unless}}">{{value}}</td>
  </tr>
  {{/each}}
</table>
